// math.js 1


function add (a, b) {
    return a + b;
}

function subtract (a, b) {
    return a - b;
}

function multiply (a, b) {
    return a * b;
} 
const name = "micheal";

module.exports = {
    add,
    subtract,
    multiply,
    name
};

